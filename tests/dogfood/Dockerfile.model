FROM node:22.20.0-bookworm-slim@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e

RUN npm install --global --omit=dev @openai/codex@0.153.4 \
    && npm cache clean --force \
    && groupadd --gid 10002 model \
    && useradd --uid 10002 --gid 10002 --create-home --shell /usr/sbin/nologin model

USER 10002:10002
WORKDIR /context
ENTRYPOINT ["codex"]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://substratum.dev/schemas/castor/dogfood/rate-card-v1.json",
  "title": "Castor dogfood execution-day rate card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "source_url",
    "model",
    "currency",
    "uncached_input_usd_per_million",
    "cached_input_usd_per_million",
    "output_usd_per_million",
    "output_tokens_include_reasoning"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "enum": ["USD"]
    },
    "uncached_input_usd_per_million": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "cached_input_usd_per_million": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "output_usd_per_million": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "output_tokens_include_reasoning": {
      "type": "boolean",
      "enum": [true]
    }
  }
}

FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

RUN groupadd --gid 10001 castor \
    && useradd --uid 10001 --gid 10001 --no-create-home \
        --shell /usr/sbin/nologin castor

COPY castor_client-0.7.0a1-py3-none-any.whl /tmp/castor_client-0.7.0a1-py3-none-any.whl
RUN python -m pip install --no-index --no-deps /tmp/castor_client-0.7.0a1-py3-none-any.whl \
    && rm /tmp/castor_client-0.7.0a1-py3-none-any.whl

COPY castor_a_installed_agent.py /opt/castor/agent.py

USER 10001:10001
WORKDIR /opt/castor

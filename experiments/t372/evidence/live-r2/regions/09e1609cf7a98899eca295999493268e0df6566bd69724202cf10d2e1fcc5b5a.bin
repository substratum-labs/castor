{"action_type":"WorkspaceEdit","patch":"--- a/boltons/mathutils.py\n+++ b/boltons/mathutils.py\n@@ -169,9 +169,11 @@\n     def __getitem__(self, k):\n         if type(k) is slice:\n             return Bits(self.as_bin()[k])\n         if type(k) is int:\n-            if k >= self.len:\n+            if k < 0:\n+                k = self.len + k\n+            if k >= self.len or k < 0:\n                 raise IndexError(k)\n             return bool((1 << (self.len - k - 1)) & self.val)\n         raise TypeError(type(k))\n \n","target_path":"boltons/mathutils.py"}